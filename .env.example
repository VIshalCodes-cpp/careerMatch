# Required: PostgreSQL. A free Neon/Supabase database works; use a local one for offline development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careermatch?schema=public
# Application signing secret (not a third-party API key). Use a unique random value of 32+ characters.
ACCESS_TOKEN_SECRET=local-only-change-this-secret-to-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:8080
# Google OAuth client ID (public). Add http://localhost:8080 to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Job board imports. Import runs automatically at startup when the board is empty or older than the interval.
JOB_SYNC_ENABLED=true
JOB_SYNC_INTERVAL_HOURS=6
# Owner account used for imported public listings (no password, cannot sign in).
JOB_IMPORT_EMAIL=jobs@careermatch.local

# --- India-focused feeds (recommended) ---
# Country used by the Adzuna feed: in, gb, us, de, au, ca, sg, ... (default: in)
JOB_IMPORT_COUNTRY=in
# Optional search term (Adzuna `what`, Jooble `keywords`). Leave blank for every role.
JOB_IMPORT_QUERY=
# Optional city filter, e.g. Bengaluru. Jooble defaults to the country name when blank.
JOB_IMPORT_LOCATION=
# Adzuna: free key pair from https://developer.adzuna.com (2 minutes, no card).
# The feed is skipped until both values are set.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Pages of 50 Adzuna results to fetch per sync (1-5).
ADZUNA_PAGES=2
# Jooble: request a free API key at https://jooble.org/api/about.
JOOBLE_API_KEY=
# Comma-separated feeds to skip, e.g. "Arbeitnow" to drop the German-only board.
# Valid names: Adzuna, Jooble, Remotive, Jobicy, RemoteOK, Arbeitnow
JOB_IMPORT_DISABLED=

# --- Password reset and email verification ---
# Pick ONE transport and set EMAIL_FROM. Without a configured transport, development
# shows the reset link on /reset-password instead, and production sends nothing.
#
# Option A - Brevo (no domain needed). Verify a single sender address in the Brevo
# dashboard, then create an API key. Works for any recipient.
#   https://app.brevo.com -> Senders, Domains & IPs -> Senders
#   https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
#
# Option B - Resend (needs a verified domain for real recipients). Free key:
#   https://resend.com/api-keys
# Without a verified domain you may send from onboarding@resend.dev, but Resend
# then only delivers to the email address that owns the Resend account.
RESEND_API_KEY=
#
# Sender address. With Brevo: the verified sender. With Resend: an address on the
# verified domain (or onboarding@resend.dev). Display names are allowed.
#   EMAIL_FROM="CareerMatch <no-reply@yourdomain.com>"
#   EMAIL_FROM="CareerMatch <onboarding@resend.dev>"
EMAIL_FROM=

# Optional self-hosted Python NLP service. Resume parsing and ranking work without it.
# When set, it is used for resume parsing and its vectors are stored alongside local results.
ML_SERVICE_URL=
# Optional. Set a strong shared secret only if the service is reachable remotely.
ML_SERVICE_API_KEY=
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Use local storage for development. Production defaults to the PostgreSQL database unless S3 is configured.
RESUME_STORAGE=local
RESUME_LOCAL_DIR=.private/resumes
# Optional for production. PostgreSQL storage needs no extra keys and is suitable for small apps.
# For larger files/volume, set RESUME_STORAGE=s3 and provide a private bucket.
RESUME_S3_BUCKET=
AWS_REGION=auto
RESUME_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional one-time admin bootstrap secret. Leave unset to disable the bootstrap endpoint.
ADMIN_BOOTSTRAP_SECRET=

# Configurable recommendation formula. Weights are normalized at request time when a signal is unavailable.
MATCH_WEIGHT_SEMANTIC=0.35
MATCH_WEIGHT_SKILL=0.25
MATCH_WEIGHT_EXPERIENCE=0.15
MATCH_WEIGHT_EDUCATION=0.05
MATCH_WEIGHT_PREFERENCE=0.15
MATCH_WEIGHT_COLLABORATIVE=0.05
